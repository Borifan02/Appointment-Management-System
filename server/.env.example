# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/medicare_hub
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/medicare_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medicare_hub

# JWT Secret & Expiration
JWT_SECRET=medicare_super_secret_jwt_key_2026_portfolio
JWT_EXPIRE=30d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:3000
